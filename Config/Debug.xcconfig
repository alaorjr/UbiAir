ALWAYS_SEARCH_USER_PATHS = NO
PRODUCT_BUNDLE_IDENTIFIER = ai.ubiquu.UbiAir
PRODUCT_NAME = UbiAir
CONFIGURATION_BUILD_DIR = $(SRCROOT)/build/XcodeSandbox/Build/Products/$(CONFIGURATION)
EXECUTABLE_NAME = UbiAir
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_OPTIMIZATION_LEVEL = -Onone
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Resources/Info.plist
CODE_SIGN_ENTITLEMENTS = Config/UbiAir.entitlements
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG UBIAIR_SANDBOX
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
MARKETING_VERSION = 0.1.10
CURRENT_PROJECT_VERSION = 11
ONLY_ACTIVE_ARCH = YES
ARCHS = $(ARCHS_STANDARD)

#include? "Local.xcconfig"
